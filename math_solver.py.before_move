"""Small symbolic worker. JSON stdin only; an AST allowlist never executes Python."""
from __future__ import annotations
import ast
import json
import sys
import sympy as sp

FUNCTIONS = {"sqrt": sp.sqrt, "sin": sp.sin, "cos": sp.cos, "tan": sp.tan,
             "asin": sp.asin, "acos": sp.acos, "atan": sp.atan,
             "log": sp.log, "ln": sp.log, "exp": sp.exp, "abs": sp.Abs}
SYMBOLS = {name: sp.Symbol(name, real=True) for name in "xyzabcnt"}
NAMES = {**SYMBOLS, "pi": sp.pi, "E": sp.E}

def parse_expression(text: str):
    if not isinstance(text, str) or not text.strip() or len(text) > 500:
        raise ValueError("Expression must be 1-500 characters.")
    text = text.strip().replace('−', '-').replace('×', '*').replace('÷', '/').replace('^', '**')
    tree = ast.parse(text, mode='eval')
    if sum(1 for _ in ast.walk(tree)) > 100:
        raise ValueError('Expression is too complex.')
    def visit(node):
        if isinstance(node, ast.Constant) and type(node.value) in (int, float):
            literal = ast.get_source_segment(text, node)
            if len(literal) > 30:
                raise ValueError('Number is too large.')
            value = sp.Rational(literal)
            if abs(value) > 10**100:
                raise ValueError('Number is too large.')
            return value
        if isinstance(node, ast.Name) and node.id in NAMES:
            return NAMES[node.id]
        if isinstance(node, ast.UnaryOp) and isinstance(node.op, (ast.UAdd, ast.USub)):
            value = visit(node.operand)
            return value if isinstance(node.op, ast.UAdd) else -value
        if isinstance(node, ast.BinOp):
            left, right = visit(node.left), visit(node.right)
            if isinstance(node.op, ast.Add): return sp.Add(left, right, evaluate=False)
            if isinstance(node.op, ast.Sub): return sp.Add(left, -right, evaluate=False)
            if isinstance(node.op, ast.Mult): return sp.Mul(left, right, evaluate=False)
            if isinstance(node.op, ast.Div):
                if right.equals(0): raise ValueError('Division by zero.')
                return sp.Mul(left, sp.Pow(right, -1, evaluate=False), evaluate=False)
            if isinstance(node.op, ast.Pow):
                if right.is_number and (right.is_real is not True or abs(right) > 1000):
                    raise ValueError('Numeric exponent must be real and between -1000 and 1000.')
                return sp.Pow(left, right, evaluate=False)
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and len(node.args) == 1 and not node.keywords:
            if node.func.id == 'log10': return sp.log(visit(node.args[0]), 10, evaluate=False)
            if node.func.id in FUNCTIONS: return FUNCTIONS[node.func.id](visit(node.args[0]), evaluate=False)
        raise ValueError('Unsupported syntax. Use explicit *, variables x,y,z,a,b,c,n,t and named functions. Substitute numeric values for names such as y_mid or m_perp first.')
    return visit(tree.body)

def calculate(operation: str, expression: str, variable: str = 'x') -> dict:
    if variable not in SYMBOLS: raise ValueError('Variable must be one of x,y,z,a,b,c,n,t.')
    if not isinstance(expression, str) or len(expression) > 1000: raise ValueError('Expression must be text up to 1000 characters.')
    symbol = SYMBOLS[variable]
    if operation == 'perpendicular_bisector':
        parts = expression.split(',')
        if len(parts) != 4: raise ValueError('Supply x1,y1,x2,y2, for example -8,6,-4,2.')
        values = [sp.simplify(parse_expression(p)) for p in parts]
        if any(v.free_symbols or v.is_real is not True or v.is_finite is not True for v in values):
            raise ValueError('Coordinates must be finite real numbers.')
        x1,y1,x2,y2 = values
        dx,dy = sp.simplify(x2-x1),sp.simplify(y2-y1)
        if dx == 0 and dy == 0: raise ValueError('Distinct endpoints are required.')
        mx,my = sp.simplify((x1+x2)/2),sp.simplify((y1+y2)/2)
        lhs,rhs = (SYMBOLS['x'],mx) if dy == 0 else (SYMBOLS['y'],sp.expand(my-dx/dy*(SYMBOLS['x']-mx)))
        eq = sp.Eq(lhs,rhs)
        return {'operation':operation,'equation':str(eq),'latex':sp.latex(eq),'lhs':str(lhs),'rhs':str(rhs),'rhs_latex':sp.latex(rhs),'midpoint':[str(mx),str(my)],'note':'If the field already shows y= or x=, enter only rhs_latex.'}
    if operation == 'solve':
        parts = expression.split('=')
        if len(parts)>2: raise ValueError('Supply one equation, not a system or inequality.')
        left=parse_expression(parts[0]); right=parse_expression(parts[1]) if len(parts)==2 else sp.Integer(0)
        expr=sp.Add(left,-right,evaluate=False)
        if expr.free_symbols-{symbol}: raise ValueError('Single-variable equations only. For line equations use simplify on the RHS or perpendicular_bisector with four coordinates.')
        denominators=[p.base for p in sp.preorder_traversal(expr) if isinstance(p,sp.Pow) and p.exp.is_negative]
        result=sp.solveset(expr,symbol,domain=sp.S.Reals)
        for denominator in denominators: result=result-sp.solveset(denominator,symbol,domain=sp.S.Reals)
        checks={}; roots=[]
        if isinstance(result,sp.FiniteSet):
            for root in sorted(result,key=sp.default_sort_key):
                residual=sp.simplify(expr.subs(symbol,root))
                checks[str(root)]=str(residual)
                roots.append({'exact':str(root),'latex':sp.latex(root),'verified':residual == 0})
        return {'operation':operation,'input':expression,'domain':'real','result':str(result),'latex':sp.latex(result),'solutions':roots,'residuals_should_be_zero':checks,'complete':not result.has(sp.ConditionSet),'note':'EmptySet means no real solutions. ConditionSet is unresolved. Choose the answer format requested by the page, not automatically the entire set.'}
    expr=parse_expression(expression)
    functions={'evaluate':sp.simplify,'simplify':sp.simplify,'factor':sp.factor,'expand':sp.expand,'differentiate':lambda e:sp.diff(e,symbol),'integrate':lambda e:sp.integrate(e,symbol)}
    if operation not in functions: raise ValueError('Unknown operation.')
    result=functions[operation](expr)
    if result.has(sp.zoo,sp.nan,sp.oo,-sp.oo): raise ValueError('Expression is undefined or non-finite.')
    return {'operation':operation,'input':expression,'exact':str(result),'latex':sp.latex(result),'decimal':str(sp.N(result,15)) if not result.free_symbols else None,'complete':not result.has(sp.Integral,sp.Derivative),'note':'Trig uses radians. log/ln are natural; log10 is base 10. Preserve original domain restrictions. Add +C for indefinite integrals.'}

if __name__ == '__main__':
    try:
        raw=sys.stdin.buffer.read(8193)
        if len(raw)>8192: raise ValueError('Request too large.')
        payload=json.loads(raw)
        if not isinstance(payload,dict): raise ValueError('Expected a JSON object.')
        print(json.dumps(calculate(**payload)))
    except Exception as exc:
        print(json.dumps({'error':type(exc).__name__,'message':str(exc)[:400]}))
